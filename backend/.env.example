# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (проверьте, что он в .gitignore).

# Локальный Postgres из docker-compose.yml (см. корень проекта):
DATABASE_URL=postgresql://compliance:compliance_local_pw@localhost:5432/compliance_db
# Локально SSL отключаем (в docker-compose он не настроен). На проде (Render)
# эту строку просто не добавляйте — там по умолчанию require.
DB_SSL_MODE=disable

# Ключ для подписи JWT-токенов авторизации — придумайте длинную случайную строку.
SECRET_KEY=change-me-to-a-long-random-string

# Ключ для шифрования данных отчётов в БД (encryption_utils.py).
# Должен быть валидным Fernet-ключом. Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Ключ DeepSeek API — получить на https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Ключи ЮKassa — из личного кабинета: Настройки → Данные для API.
# ВАЖНО: боевые ключи = реальные деньги, храните так же осторожно, как
# остальные секреты выше.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Домен фронтенда — куда редиректить пользователя после оплаты
# (см. /api/payments/create). Локально обычно http://localhost:3000.
FRONTEND_URL=http://localhost:3000
